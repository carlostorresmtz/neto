# ── Anthropic (Claude) ──
ANTHROPIC_API_KEY=

# ── Google OAuth (Gmail) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ──
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Stripe (prueba gratis de 2 meses + cobro al mes 3) ──
# Llave secreta (sk_test_... en pruebas, sk_live_... en producción)
STRIPE_SECRET_KEY=
# ID del precio recurrente del plan (price_...) creado en el dashboard de Stripe
STRIPE_PRICE_ID=
# Signing secret del webhook (whsec_...) — endpoint: /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Días de prueba gratis antes del primer cobro (opcional, default 60 = ~2 meses)
STRIPE_TRIAL_DAYS=60
